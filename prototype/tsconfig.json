{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "baseUrl": ".",
    "paths": {
      "@tauri-apps/api/core": [
        "prototype/core.ts"
      ],
      "@tauri-apps/api/event": [
        "prototype/event.ts"
      ],
      "@tauri-apps/api/window": [
        "prototype/window.ts"
      ]
    }
  },
  "include": [
    "src"
  ]
}
